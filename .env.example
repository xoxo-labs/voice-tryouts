# Copy this file to .env.local and fill in your key, then restart `npm run dev`.
#
# Used server-side only, to mint short-lived Realtime client secrets at
# POST /api/realtime/transcription-token. It is never sent to the browser —
# the browser only ever receives an ephemeral `ek_...` secret.
#
# Create one at https://platform.openai.com/settings/organization/api-keys
OPENAI_API_KEY=sk-proj-...
